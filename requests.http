@baseUrl = http://localhost:3000
@authToken = {{login.response.body.token}}
@refreshToken = {{login.response.body.refreshToken}}

### 1. Register Candidate User
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "candidate_test@gedpro.com",
  "password": "password123",
  "confirmPassword": "password123",
  "firstName": "Test",
  "lastName": "Candidate"
}

### 2. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "candidate_test@gedpro.com",
    "password": "password123"
}

### 3. Get Profile (Test Auth)
GET {{baseUrl}}/users/profile
Authorization: Bearer {{authToken}}

### Rotate refresh token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Request password reset (always returns the same generic response)
POST {{baseUrl}}/auth/password-reset/request
Content-Type: application/json

{ "email": "candidate_test@gedpro.com" }

### 4. Create Candidate
POST {{baseUrl}}/candidates
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "firstName": "Alice",
    "lastName": "Candidate",
    "email": "alice@example.com",
    "phone": "555-0101"
}

### 5. List Candidates
GET {{baseUrl}}/candidates
Authorization: Bearer {{authToken}}

### 6. Update Candidate State
@candidateId = 1
PATCH {{baseUrl}}/candidates/{{candidateId}}/state
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "state": "preselected",
    "comment": "Moving to preselected phase"
}

### 7. Create Dynamic Form
# @name createForm
POST {{baseUrl}}/forms
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Interview Evaluation",
    "description": "Standard technical interview form",
    "fields": [
        { "label": "Technical Rating (1-10)", "type": "number", "required": true },
        { "label": "Communication", "type": "text", "required": true },
        { "label": "Recommendation", "type": "select", "options": ["Hire", "No Hire", "Maybe"] }
    ]
}

### 8. List Forms
# @name listForms
GET {{baseUrl}}/forms
Authorization: Bearer {{authToken}}

### 9. Get One Form
@formId = {{listForms.response.body.$[0]._id}}
GET {{baseUrl}}/forms/{{formId}}
Authorization: Bearer {{authToken}}

### 10. Submit Response
# @name submitResponse
POST {{baseUrl}}/forms/{{formId}}/submit
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "candidateId": 1,
    "answers": {
        "Technical Rating (1-10)": 9,
        "Communication": "Excellent english skills",
        "Recommendation": "Hire"
    }
}

### 11. Schedule Interview
# @name scheduleInterview
POST {{baseUrl}}/interviews
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "candidateId": 1,
    "date": "2026-06-15T10:00:00Z",
    "type": "HR",
    "duration": 45,
    "location": "Google Meet",
    "attendees": []
}

### 12. List Interviews
GET {{baseUrl}}/interviews
Authorization: Bearer {{authToken}}

### 13. Cancel Interview
@interviewId = 1
PATCH {{baseUrl}}/interviews/{{interviewId}}/cancel
Authorization: Bearer {{authToken}}
