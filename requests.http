@baseUrl = http://localhost:3000
@authToken = {{login.response.body.token}}
@refreshToken = {{login.response.body.refreshToken}}

### 1. Register Candidate User
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "candidate_test@gedpro.com",
  "password": "password123",
  "confirmPassword": "password123",
  "firstName": "Test",
  "lastName": "Candidate"
}

### 2. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "candidate_test@gedpro.com",
    "password": "password123"
}

### 3. Get Profile (Test Auth)
GET {{baseUrl}}/users/profile
Authorization: Bearer {{authToken}}

### Rotate refresh token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Request password reset (always returns the same generic response)
POST {{baseUrl}}/auth/password-reset/request
Content-Type: application/json

{ "email": "candidate_test@gedpro.com" }

### 4. Create Candidate
POST {{baseUrl}}/candidates
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "firstName": "Alice",
    "lastName": "Candidate",
    "email": "alice@example.com",
    "phone": "555-0101"
}

### 5. List Candidates
GET {{baseUrl}}/candidates
Authorization: Bearer {{authToken}}

### 6. Update Candidate State
@candidateId = 1
PATCH {{baseUrl}}/candidates/{{candidateId}}/state
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "state": "preselected",
    "comment": "Moving to preselected phase"
}

### 7. Create Dynamic Form
# @name createForm
POST {{baseUrl}}/forms
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Interview Evaluation",
    "description": "Standard technical interview form",
    "fields": [
        { "label": "Technical Rating (1-10)", "type": "number", "required": true },
        { "label": "Communication", "type": "text", "required": true },
        { "label": "Recommendation", "type": "select", "options": ["Hire", "No Hire", "Maybe"] }
    ]
}

### 8. List Forms
# @name listForms
GET {{baseUrl}}/forms
Authorization: Bearer {{authToken}}

### 9. Get One Form
@formId = {{listForms.response.body.$[0]._id}}
GET {{baseUrl}}/forms/{{formId}}
Authorization: Bearer {{authToken}}

### 10. Submit Response
# @name submitResponse
POST {{baseUrl}}/forms/{{formId}}/submit
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "candidateId": 1,
    "answers": {
        "Technical Rating (1-10)": 9,
        "Communication": "Excellent english skills",
        "Recommendation": "Hire"
    }
}

### 11. Schedule Interview
# @name scheduleInterview
POST {{baseUrl}}/interviews
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "candidateId": 1,
    "applicationId": 1,
    "date": "2026-06-15T10:00:00Z",
    "type": "HR",
    "duration": 45,
    "location": "Google Meet",
    "interviewerIds": [1],
    "attendeeIds": [],
    "round": 1,
    "scorecardTemplateId": 1,
    "feedbackDeadline": "2026-06-16T10:00:00Z",
    "hideFeedbackUntilComplete": true,
    "calendarProvider": "internal"
}

### Create a job-linked scorecard template
POST {{baseUrl}}/interviews/scorecard-templates
Authorization: Bearer {{authToken}}
Content-Type: application/json

{ "name": "Technical", "jobId": 1, "criteria": [{ "key": "technical", "label": "Technical ability", "minRating": 1, "maxRating": 5 }] }

### Reschedule with availability validation
PATCH {{baseUrl}}/interviews/{{interviewId}}/reschedule
Authorization: Bearer {{authToken}}
Content-Type: application/json

{ "date": "2026-06-17T10:00:00Z", "duration": 60 }

### Submit assigned feedback
POST {{baseUrl}}/interviews/scorecards/1/submit
Authorization: Bearer {{authToken}}
Content-Type: application/json

{ "ratings": { "technical": 5 }, "recommendation": "strong_yes", "privateNotes": "Private reviewer notes" }

### Hiring decision scorecard completion
GET {{baseUrl}}/interviews/applications/1/decision-summary
Authorization: Bearer {{authToken}}

### 12. List Interviews
GET {{baseUrl}}/interviews
Authorization: Bearer {{authToken}}

### 13. Cancel Interview
@interviewId = 1
PATCH {{baseUrl}}/interviews/{{interviewId}}/cancel
Authorization: Bearer {{authToken}}

### Create a reusable hiring pipeline
# @name createPipeline
POST {{baseUrl}}/pipelines
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Engineering pipeline",
  "stages": [
    { "name": "Applied", "category": "applied", "position": 1 },
    { "name": "Technical review", "category": "screening", "position": 2 },
    { "name": "Hired", "category": "hired", "position": 3 }
  ]
}

### Configure an allowed transition
PUT {{baseUrl}}/pipelines/{{createPipeline.response.body.id}}/stages/{{createPipeline.response.body.stages[0].id}}/transitions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{ "toStageIds": [{{createPipeline.response.body.stages[1].id}}] }

### Search candidate records
GET {{baseUrl}}/candidates?search=alice&skill=typescript&page=1&limit=20
Authorization: Bearer {{authToken}}

### Update candidate metadata and consent
PATCH {{baseUrl}}/candidates/{{candidateId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{ "tags": ["priority"], "skills": ["typescript"], "source": "referral", "privacyConsent": true }

### Review duplicate candidates
GET {{baseUrl}}/candidates/{{candidateId}}/duplicates
Authorization: Bearer {{authToken}}

### Export candidate personal data
GET {{baseUrl}}/candidates/{{candidateId}}/privacy/export
Authorization: Bearer {{authToken}}

### Add an internal recruiter note to the candidate journey
POST {{baseUrl}}/candidates/{{candidateId}}/timeline/notes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{ "text": "Candidate prefers afternoon interviews.", "visibility": "internal" }

### Read the first stable timeline page
# @name candidateTimeline
GET {{baseUrl}}/candidates/{{candidateId}}/timeline?limit=20
Authorization: Bearer {{authToken}}

### Continue with the opaque cursor from the prior page
GET {{baseUrl}}/candidates/{{candidateId}}/timeline?limit=20&cursor={{candidateTimeline.response.body.nextCursor}}

### List candidate documents
GET {{baseUrl}}/documents?candidateId={{candidateId}}
Authorization: Bearer {{accessToken}}

### Expiring document URL (replace 1 with an uploaded document ID)
GET {{baseUrl}}/documents/1/url
Authorization: Bearer {{accessToken}}
Authorization: Bearer {{authToken}}
