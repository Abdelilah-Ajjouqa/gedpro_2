{
  "name": "gedpro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace @gedpro/api",
    "dev:web": "npm run dev --workspace @gedpro/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @gedpro/api",
    "test:cov": "npm run test:cov --workspace @gedpro/api",
    "test:e2e": "npm run test:e2e --workspace @gedpro/api",
    "openapi:generate": "npm run openapi:generate --workspace @gedpro/api",
    "openapi:check": "npm run openapi:check --workspace @gedpro/api",
    "migration:run": "npm run migration:run --workspace @gedpro/api",
    "migration:revert": "npm run migration:revert --workspace @gedpro/api",
    "seed": "npm run seed --workspace @gedpro/api",
    "admin:bootstrap": "npm run admin:bootstrap --workspace @gedpro/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
