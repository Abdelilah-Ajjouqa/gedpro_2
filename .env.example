# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gedpro_user
POSTGRES_PASSWORD=gedpro_password
POSTGRES_DB=gedpro_db
# Development convenience only. Use migrations and set false in production.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# MongoDB Configuration
MONGODB_URI=mongodb://gedpro_user:gedpro_password@localhost:27018/gedpro?authSource=admin

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret

# Server Configuration
PORT=3000
UPLOAD_DIR=uploads

# One-time administrator bootstrap (used by npm run admin:bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_FIRST_NAME=GEDPro
ADMIN_LAST_NAME=Admin
