# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gedpro_user
POSTGRES_PASSWORD=gedpro_password
POSTGRES_DB=gedpro_db
# Development convenience only. Use migrations and set false in production.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# MongoDB Configuration
MONGODB_URI=mongodb://gedpro_user:gedpro_password@localhost:27018/gedpro?authSource=admin

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
ACTION_TOKEN_TTL_SECONDS=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
CORS_ORIGINS=http://localhost:3000

# Server Configuration
PORT=3000
UPLOAD_DIR=uploads

# One-time administrator bootstrap (used by npm run admin:bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_FIRST_NAME=GEDPro
ADMIN_LAST_NAME=Admin
