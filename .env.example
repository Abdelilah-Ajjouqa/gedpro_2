# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gedpro_user
POSTGRES_PASSWORD=gedpro_password
POSTGRES_DB=gedpro_db
# Development convenience only. Use migrations and set false in production.
DB_SYNCHRONIZE=true

# MongoDB Configuration
MONGODB_URI=mongodb://gedpro_user:gedpro_password@localhost:27018/gedpro?authSource=admin

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret

# Server Configuration
PORT=3000
UPLOAD_DIR=uploads
